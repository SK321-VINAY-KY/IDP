# Normalize line endings to LF on commit, checkout as native
* text=auto

# Explicitly LF for all code and config files
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.env.example text eol=lf

# Binary — no line-ending normalization
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.bin   binary
*.pt    binary
*.onnx  binary
