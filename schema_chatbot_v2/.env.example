# Which adapter to use: bedrock | sarvam | ollama | mock
LLM_PROVIDER=bedrock

# --- Bedrock (AWS deployment) ---
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=arn:aws:bedrock:ap-south-1:106611079163:application-inference-profile/qdtz23c8eis1
BEDROCK_REASONING_EFFORT=low

# --- Ollama (local dev only) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=60

# --- Sarvam AI ---
SARVAM_API_KEY=sk_your_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_TIMEOUT_S=60

# --- Sarvam Document AI (only used for POST /schema/infer, document upload) ---
SARVAM_DOC_AI_LANGUAGE=en-IN
SARVAM_DOC_AI_POLL_INTERVAL_S=6
SARVAM_DOC_AI_TIMEOUT_S=120

# --- Storage ---
SESSION_STORE=memory

LOG_LEVEL=INFO
