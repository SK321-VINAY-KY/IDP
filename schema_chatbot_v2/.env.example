# Which adapter to use: ollama | bedrock | mock
LLM_PROVIDER=ollama

# --- Ollama (local dev) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=60

# --- Bedrock (later, on AWS) ---
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Sarvam AI ---
SARVAM_API_KEY=sk_your_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_TIMEOUT_S=60

# --- Sarvam Document AI (only used for POST /schema/infer, document upload) ---
SARVAM_DOC_AI_LANGUAGE=en-IN
SARVAM_DOC_AI_POLL_INTERVAL_S=6
SARVAM_DOC_AI_TIMEOUT_S=120

# --- Storage ---
SESSION_STORE=memory

LOG_LEVEL=INFO
