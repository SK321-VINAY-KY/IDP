# ==============================================================================
# IDP Enterprise Intelligent Document Processing — Production Configuration
# Copy this template to .env and configure all variables before deploying:
#   cp .env.example .env
# NOTE: All secrets must be securely generated and provided via AWS Secrets
#       Manager or Parameter Store in production. Placeholders only below.
# ==============================================================================

# ==============================================================================
# 1. CORE WEB APP & AUTHENTICATION (FastAPI Web App / ECS)
# ==============================================================================
# Environment: must be "production" for AWS deployments (strict security enabled)
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=https://idp.yourdomain.com

# Request Limits: Upload Size Limit (bytes, default 20MB) & Rate Limiting
MAX_UPLOAD_SIZE_BYTES=20971520
RATE_LIMIT_EXTRACT_MAX_REQUESTS=5
RATE_LIMIT_EXTRACT_WINDOW_SECONDS=60

# JWT Authentication (generate with: openssl rand -hex 32)
# Production requires at least 32 characters and non-default value
JWT_SECRET=replace_with_at_least_32_char_cryptographically_secure_random_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Initial Admin Credentials (must not be 'changeme' or 'admin123' in production)
ADMIN_USERNAME=prod_admin
ADMIN_PASSWORD=replace_with_strong_production_admin_password_min_16_chars

# User Store: "postgres" (recommended for production) | "json" | "memory"
USER_STORE_TYPE=postgres
USER_STORE_FILE=data/users.json

# Session Store: "memory" | "file"
SESSION_STORE=memory
# SESSION_STORE_FILE=data/sessions.json

# PostgreSQL Database Connection String
# In production, must not contain default passwords like 'password' or '12345'
DATABASE_URL=postgresql://idp_user:replace_with_strong_db_password@postgres-prod.your-vpc.rds.amazonaws.com:5432/idp_db

# ==============================================================================
# 2. LAYER 3 LLM EXTRACTION & REASONING (Web App & Extraction Worker)
# ==============================================================================
# Extraction Backend: "sarvam" | "bedrock" | "ollama"
LLM_PROVIDER=sarvam
EXTRACTION_BACKEND=sarvam

# Sarvam AI Production Settings (required when LLM_PROVIDER=sarvam)
SARVAM_API_KEY=your_sarvam_production_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_S=180
# Optional reasoning effort: "low" | "medium" | "high" | null
SARVAM_REASONING_EFFORT=

# Sarvam Document AI Settings (for /schema/infer sample document intake)
SARVAM_DOC_AI_LANGUAGE=en-IN
SARVAM_DOC_AI_POLL_INTERVAL_S=6
SARVAM_DOC_AI_TIMEOUT_S=120

# AWS Bedrock Settings (required when LLM_PROVIDER=bedrock)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ollama Fallback Settings (for on-premise/hybrid deployments)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=60

# Google Gemini Settings (optional, when LLM_PROVIDER=gemini)
IDP_GEMINI_API_KEY=
IDP_GEMINI_BASE_URL=

# Layer 3 Graph Memory Strategy
LAYER3_STRATEGY=graph_memory
GRAPH_CONCURRENCY_LIMIT=8
GRAPH_ANCHOR_MAX_K=5
# GRAPH_ANCHOR_TYPES=HEADER,TOTAL,TAX_ID,TABLE

# ==============================================================================
# 3. AWS CLOUD & STORAGE (Shared by Web App & Lambda Handlers)
# ==============================================================================
# AWS Region
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# S3 Bucket for Storing Uploaded Documents, Markdown, and Extracted JSON
S3_BUCKET_NAME=your-production-idp-documents-bucket
S3_PREFIX=dataset_output/

# IAM Authentication: If running in ECS / Lambda, execution roles handle credentials
# automatically. Set these ONLY for local production testing:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ==============================================================================
# 4. LAYER 1 LAMBDA (Page Inspection & Capability Routing)
# Handler: src.api.lambda_layer1_handler.lambda_handler
# ==============================================================================
# Routing Mode: "single_engine" | "capability_based"
IDP_ROUTING_MODE=single_engine

# Layer 1 Page Inspection Thresholds
IDP_DIGITAL_CHAR_COUNT_THRESHOLD=100
IDP_SCANNED_CHAR_COUNT_THRESHOLD=30
IDP_SCANNED_IMAGE_COVERAGE_THRESHOLD=0.25
IDP_SKIP_CHAR_COUNT_THRESHOLD=20
IDP_SKIP_IMAGE_COVERAGE_THRESHOLD=0.02
IDP_HANDWRITING_PCT_SCANNED_CEILING=0.10
IDP_HANDWRITING_PCT_HANDWRITTEN_FLOOR=0.30
IDP_VLM_DIRECT_EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# Escalation Ladder
IDP_ESCALATION_CONFIDENCE_THRESHOLD=0.70
IDP_MAX_ESCALATION_ATTEMPTS=1

# Capability-based Routing (Stage 1) Thresholds
IDP_CAPABILITY_DIGITAL_ONLY_CHAR_THRESHOLD=500
IDP_CAPABILITY_SCAN_SUPPLEMENT_IMAGE_THRESHOLD=0.10
IDP_CAPABILITY_DUAL_OCR_SCAN_THRESHOLD=0.25
IDP_CAPABILITY_LOW_CONFIDENCE_FLOOR=0.50
IDP_CAPABILITY_MAX_ENGINES_PER_PAGE=3

# ==============================================================================
# 5. LAYER 2 ENGINE LAMBDAS / CONTAINERS (OCR & Conversion)
# ==============================================================================
# PaddleOCR Handwriting Detection Threshold
IDP_PADDLE_HANDWRITING_DET_DB_THRESH=0.20

# VLM Configuration (if VLM conversion engine is enabled)
IDP_VLM_MODEL_NAME=qwen2.5vl:7b
