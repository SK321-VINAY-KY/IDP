# ==============================================================================
# IDP Project — Environment Configuration Template
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Layer 1 + Layer 2 Pipeline Configuration (Engineer A)
# Prefix: IDP_
# ------------------------------------------------------------------------------

# VLM / LLM Provider: "ollama" | "gemini"
IDP_LLM_PROVIDER=ollama

# Ollama Settings (when running locally or inside Docker)
# Note: Use host.docker.internal when connecting to Ollama running on host from Docker
IDP_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
IDP_VLM_MODEL_NAME=qwen2.5vl:7b

# Google Gemini Settings (when IDP_LLM_PROVIDER=gemini)
IDP_GEMINI_API_KEY=your_gemini_api_key_here
IDP_GEMINI_BASE_URL=

# Routing & Execution Modes: "single_engine" (default) | "capability_based"
IDP_ROUTING_MODE=single_engine

# Pipeline Routing Thresholds
IDP_DIGITAL_CHAR_COUNT_THRESHOLD=100
IDP_SCANNED_CHAR_COUNT_THRESHOLD=30
IDP_SCANNED_IMAGE_COVERAGE_THRESHOLD=0.25
IDP_SKIP_CHAR_COUNT_THRESHOLD=20
IDP_SKIP_IMAGE_COVERAGE_THRESHOLD=0.02
IDP_HANDWRITING_PCT_SCANNED_CEILING=0.10
IDP_HANDWRITING_PCT_HANDWRITTEN_FLOOR=0.30
IDP_VLM_DIRECT_EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# Escalation Ladder Thresholds
IDP_ESCALATION_CONFIDENCE_THRESHOLD=0.70
IDP_MAX_ESCALATION_ATTEMPTS=1

# PaddleOCR Engine Settings
IDP_PADDLE_HANDWRITING_DET_DB_THRESH=0.20

# Capability-based Routing (Stage 1) Thresholds
IDP_CAPABILITY_DIGITAL_ONLY_CHAR_THRESHOLD=500
IDP_CAPABILITY_SCAN_SUPPLEMENT_IMAGE_THRESHOLD=0.10
IDP_CAPABILITY_DUAL_OCR_SCAN_THRESHOLD=0.25
IDP_CAPABILITY_LOW_CONFIDENCE_FLOOR=0.50
IDP_CAPABILITY_MAX_ENGINES_PER_PAGE=3

# ------------------------------------------------------------------------------
# Layer 3 Schema Discovery Chatbot Configuration (Engineer B)
# ------------------------------------------------------------------------------

# LLM Provider for Chatbot: "sarvam" | "ollama" | "bedrock" | "mock"
LLM_PROVIDER=sarvam

# Sarvam AI Settings (recommended for schema discovery)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_TIMEOUT_S=180

# Sarvam Document AI (used for POST /schema/infer sample document intake)
SARVAM_DOC_AI_LANGUAGE=en-IN
SARVAM_DOC_AI_POLL_INTERVAL_S=6
SARVAM_DOC_AI_TIMEOUT_S=120

# Ollama Settings for Chatbot (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=60

# AWS Bedrock Settings (when LLM_PROVIDER=bedrock)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Chatbot Session Storage & Logging
SESSION_STORE=memory
LOG_LEVEL=INFO
