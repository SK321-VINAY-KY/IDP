# .env.example — copy to .env and fill in real values
# .env is gitignored and must NEVER be committed.
# This file is safe to commit: it contains only placeholder/dev defaults.
#
# Local Ollama + CPU-only setup (no GPU, no external LLM APIs)

# LLM / VLM provider (local Ollama)
IDP_LLM_PROVIDER=ollama
IDP_OLLAMA_BASE_URL=http://localhost:11434/v1
IDP_VLM_MODEL_NAME=qwen2-vl:2b

# Handwriting OCR engine (TrOCR replaced by PaddleOCR — see backend/README.md)
IDP_HANDWRITING_ENGINE=paddleocr
IDP_PADDLE_HANDWRITING_DET_DB_THRESH=0.2

# Escalation ladder thresholds
IDP_ESCALATION_CONFIDENCE_THRESHOLD=0.70
IDP_MAX_ESCALATION_ATTEMPTS=1

# Routing thresholds (defaults match settings.py — override only if tuning)
# IDP_DIGITAL_CHAR_COUNT_THRESHOLD=100
# IDP_SKIP_CHAR_COUNT_THRESHOLD=20
# IDP_SKIP_IMAGE_COVERAGE_THRESHOLD=0.02
# IDP_HANDWRITING_PCT_SCANNED_CEILING=0.10
# IDP_HANDWRITING_PCT_HANDWRITTEN_FLOOR=0.30
